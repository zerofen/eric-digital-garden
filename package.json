{
  "name": "eric-digital-garden",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/prepare.mjs",
    "build": "vinext build",
    "postbuild": "node scripts/finalize-static.mjs && node scripts/check-static.mjs",
    "deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "admin:dev": "wrangler dev --config cloudflare/wrangler.jsonc --port 3000",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "new-post": "node scripts/new-post.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt app components/site-header.tsx components/post-list.tsx components/collection-page.tsx lib content scripts tests vite.config.ts next.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "gray-matter": "^4.0.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "marked": "^18.0.11",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "sanitize-html": "^2.17.7",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
